# Shared secret that external callers must present in `Authorization: Bearer <value>`
# to reach the `api` function. Any inbound HTTP endpoint in this project is gated by
# this. Set to a long random string. Auto-loaded by Firebase Functions Gen 2 from
# functions/.env at runtime; gitignored at the repo root.
CODE_THAT_OTHER_SERVICES_NEED_TO_GET_PAST_OUR_BOUNCER=

# Google consent (Gmail / Calendar) for ONE owner account — granted locally
# with `npm run consent` (cmd-consent.mjs), never through a hosted route.
#
# OAuth client: Cloud Console → Google Auth Platform → Clients → type
# "Desktop app". No redirect URIs to register — desktop clients accept any
# http://127.0.0.1:<port>, which the script's throwaway local server uses.
GOOGLE_HOSTING_CONSENT_ID=
GOOGLE_HOSTING_CONSENT_KEY=

# Scopes the script asks for. Space-separated, OAuth wire format. Must also be
# registered in Cloud Console → Google Auth Platform → Data access — keep the
# two in sync. `openid email` are added by the script to identify the account.
ADMIN_CONSENTS=https://mail.google.com/ https://www.googleapis.com/auth/calendar

# Written by cmd-consent.mjs after the browser grant. Google refresh tokens
# don't rotate; this is the long-lived credential functions/src/googleConsent.ts
# uses. Ships to prod with the next `npm run deploy:functions`.
GOOGLE_HOSTING_CONSENT_REFRESH_TOKEN=
GOOGLE_HOSTING_CONSENT_EMAIL=
