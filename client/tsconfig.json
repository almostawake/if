{
  // ONE tsconfig, deliberately. The Vite React template ships three
  // (root + app + node) with project references; collapsing them means
  // there is a single obvious file to edit and no "which config owns
  // this file" guessing.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    // Deliberately OFF — both are Vite-template defaults that reject
    // perfectly ordinary code. `verbatimModuleSyntax` errors on a plain
    // `import { type Foo, bar }` mix; `erasableSyntaxOnly` errors on enums
    // and constructor parameter properties. Neither catches a real bug,
    // and both fail code that is otherwise correct.
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,

    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "isolatedModules": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@common/*": ["../functions/src/common/*"]
    }
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"]
}
